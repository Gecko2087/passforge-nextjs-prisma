{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "passforge-demo",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "passforge-demo" }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "passforge-demo",
    "database_id": "ad72dce5-341f-4a53-92f0-7d24043e6a26",
    "migrations_dir": "migrations"
  }],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": { "BETTER_AUTH_URL": "https://passforge-demo.portfolio-lucas-nieto.workers.dev" }
}
